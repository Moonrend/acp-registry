{
  "id": "minion-code",
  "name": "Minion Code",
  "version": "0.1.44",
  "enabled": false,
  "profileId": "minion-code",
  "dist": {
    "kind": "uvx",
    "package": "minion-code@0.1.44",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
