{
  "id": "grok-build",
  "name": "Grok Build",
  "version": "1.0.21",
  "enabled": false,
  "profileId": "grok",
  "dist": {
    "kind": "npx",
    "package": "@xai-official/grok@1.0.21",
    "args": [
      "agent",
      "stdio"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  }
}
