{
  "id": "codebuddy-code",
  "name": "Codebuddy Code",
  "version": "2.168.2",
  "profileId": "codebuddy",
  "dist": {
    "kind": "npx",
    "package": "@tencent-ai/codebuddy-code@2.168.2",
    "args": [
      "--acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
