{
  "id": "auggie",
  "name": "Auggie CLI",
  "version": "0.36.0",
  "enabled": false,
  "profileId": "auggie",
  "dist": {
    "kind": "npx",
    "package": "@augmentcode/auggie@0.36.0",
    "args": [
      "--acp"
    ],
    "env": {
      "AUGMENT_DISABLE_AUTO_UPDATE": "1"
    }
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
