{
  "id": "cursor",
  "name": "Cursor",
  "version": "2026.11.05",
  "profileId": "cursor",
  "dist": {
    "kind": "binary",
    "archive": "https://downloads.cursor.com/lab/2026.11.05-86047df/linux/x64/agent-cli-package.tar.gz",
    "sha256": "170b77786cbf4c93064d64fff12b71a178b968730561c64afc2e8e752535442e",
    "cmd": "./dist-package/cursor-agent",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
