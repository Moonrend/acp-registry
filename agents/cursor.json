{
  "id": "cursor",
  "name": "Cursor",
  "version": "2026.11.22",
  "profileId": "cursor",
  "dist": {
    "kind": "binary",
    "archive": "https://downloads.cursor.com/lab/2026.11.22-e9042b2/linux/x64/agent-cli-package.tar.gz",
    "sha256": "7663b1c5d1b56e095ef8e23bef38d66df6cfd665c4873470214e0e411f0f97b3",
    "cmd": "./dist-package/cursor-agent",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
