{
  "id": "pi-acp",
  "name": "pi ACP",
  "version": "0.0.33",
  "profileId": "pi",
  "dist": {
    "kind": "npx",
    "package": "pi-acp@0.0.33",
    "extraPackages": [
      "@earendil-works/pi-coding-agent@0.84.4"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  },
  "integration": {
    "zakuraRoute": true,
    "modelPrefix": "zakura/"
  }
}
