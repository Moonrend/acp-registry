{
  "id": "autohand",
  "name": "Autohand Code",
  "version": "0.9.11",
  "profileId": "autohand",
  "dist": {
    "kind": "npx",
    "package": "@autohandai/autohand-acp@0.9.11"
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
