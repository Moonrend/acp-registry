{
  "id": "qwen-code",
  "name": "Qwen Code",
  "version": "0.23.0",
  "profileId": "qwen-code",
  "dist": {
    "kind": "npx",
    "package": "@qwen-code/qwen-code@0.23.0",
    "args": [
      "--acp",
      "--experimental-skills"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
