{
  "id": "opencode",
  "name": "OpenCode",
  "version": "1.19.3",
  "profileId": "opencode",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/anomalyco/opencode/releases/download/v1.19.3/opencode-linux-x64.tar.gz",
    "sha256": "13a8fb2978302071b86f9d7e00da9c8895f9cd846978379c3bdc6a5333536c9b",
    "cmd": "./opencode",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": "home",
        "runtime": "home",
        "sync": "none",
        "when": [
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  },
  "integration": {
    "zakuraRoute": true,
    "modelPrefix": "zakura/"
  }
}
