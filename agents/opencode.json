{
  "id": "opencode",
  "name": "OpenCode",
  "version": "2.2.6",
  "profileId": "opencode",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/anomalyco/opencode/releases/download/v2.2.6/opencode-linux-x64.tar.gz",
    "sha256": "08bb21d6326ce740d91cce7ebe88a6536933f6e1e30353b91a06b01f25da306c",
    "cmd": "./opencode",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": "home",
        "runtime": "home",
        "sync": "none",
        "when": [
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  },
  "integration": {
    "zakuraRoute": true,
    "modelPrefix": "zakura/"
  }
}
