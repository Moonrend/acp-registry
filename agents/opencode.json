{
  "id": "opencode",
  "name": "OpenCode",
  "version": "1.18.30",
  "profileId": "opencode",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/anomalyco/opencode/releases/download/v1.18.30/opencode-linux-x64.tar.gz",
    "sha256": "55007246858165496ff85ba1c2b648f7421e8e2013bf4189a680c9ff8e699d17",
    "cmd": "./opencode",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": "home",
        "runtime": "home",
        "sync": "none",
        "when": [
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  },
  "integration": {
    "zakuraRoute": true,
    "modelPrefix": "zakura/"
  }
}
