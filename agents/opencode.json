{
  "id": "opencode",
  "name": "OpenCode",
  "version": "2.3.0",
  "profileId": "opencode",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/anomalyco/opencode/releases/download/v2.3.0/opencode-linux-x64.tar.gz",
    "sha256": "fc0f81522aceeabac47693d88389efa2bc517ce74c2c38fd6967819fcc6e4d3b",
    "cmd": "./opencode",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": "home",
        "runtime": "home",
        "sync": "none",
        "when": [
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  },
  "integration": {
    "zakuraRoute": true,
    "modelPrefix": "zakura/"
  }
}
