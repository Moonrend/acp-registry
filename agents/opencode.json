{
  "id": "opencode",
  "name": "OpenCode",
  "version": "1.18.29",
  "profileId": "opencode",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/anomalyco/opencode/releases/download/v1.18.29/opencode-linux-x64.tar.gz",
    "sha256": "ea800b7ff56226b70952126c9fc1e2517ca4c4b5682fd9d3f9e87449697a1194",
    "cmd": "./opencode",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "state-home",
    "xdg": true,
    "artifacts": [
      {
        "durable": "home",
        "runtime": "home",
        "sync": "exit",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": "home",
        "runtime": "home",
        "sync": "none",
        "when": [
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ]
  }
}
