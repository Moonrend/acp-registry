{
  "id": "goose",
  "name": "goose",
  "version": "1.49.0",
  "enabled": true,
  "profileId": "goose",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/block/goose/releases/download/v1.49.0/goose-x86_64-unknown-linux-gnu.tar.bz2",
    "sha256": "c631a55e7d826d28c3bcd87b71a0aaecc9612f5a44e6c0d01e7a5b82dd8b7143",
    "cmd": "./goose",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ],
    "skipWhenApiKey": true
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
