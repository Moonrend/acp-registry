{
  "id": "harn",
  "name": "Harn",
  "version": "0.10.175",
  "profileId": "harn",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.175/harn-x86_64-unknown-linux-gnu.tar.gz",
    "sha256": "4f663a217bec94e052c188c2ed16f5ee4248f313cedd3f8624093d735e54f50f",
    "cmd": "./harn",
    "args": [
      "serve",
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
