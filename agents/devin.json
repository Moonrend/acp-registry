{
  "id": "devin",
  "name": "Devin",
  "version": "3000.12.17",
  "profileId": "devin",
  "dist": {
    "kind": "binary",
    "archive": "https://static.devin.ai/cli/3000.12.17/devin-3000.12.17-x86_64-unknown-linux.tar.gz",
    "sha256": "16b1414dcb50450e654954f10cd38107f93e450d76b0dea63d0b5a65ca600d45",
    "cmd": "./bin/devin",
    "args": [
      "acp"
    ]
  },
