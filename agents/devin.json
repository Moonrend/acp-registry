{
  "id": "devin",
  "name": "Devin",
  "version": "3000.12.57",
  "profileId": "devin",
  "dist": {
    "kind": "binary",
    "archive": "https://static.devin.ai/cli/3000.12.57/devin-3000.12.57-x86_64-unknown-linux.tar.gz",
    "sha256": "0946784ef886d716e82a8026f76933bf0a6e4f0a804a23722bb62047e8c07d4a",
    "cmd": "./bin/devin",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
