{
  "id": "kilo",
  "name": "Kilo",
  "version": "7.8.1",
  "profileId": "kilo",
  "dist": {
    "kind": "npx",
    "package": "@kilocode/cli@7.8.1",
    "args": [
      "acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
