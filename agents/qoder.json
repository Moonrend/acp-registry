{
  "id": "qoder",
  "name": "Qoder CLI",
  "version": "0.2.14",
  "enabled": false,
  "profileId": "qoder",
  "dist": {
    "kind": "npx",
    "package": "@qoder-ai/qodercli@0.2.14",
    "args": [
      "--acp"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ],
    "skipWhenApiKey": true
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
