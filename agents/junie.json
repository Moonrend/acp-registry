{
  "id": "junie",
  "name": "Junie",
  "version": "3813.9.0",
  "profileId": "junie",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/JetBrains/junie-acp-release/releases/download/3813.9/junie-release-3813.9-linux-amd64.zip",
    "sha256": "50a02b7414e382974a55d13f5be3025d1b4005407aea7f1d01df4e817059560f",
    "cmd": "./junie-app/bin/junie",
    "args": [
      "--acp=true"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
