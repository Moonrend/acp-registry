{
  "id": "junie",
  "name": "Junie",
  "version": "3659.7.0",
  "profileId": "junie",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/JetBrains/junie-acp-release/releases/download/3659.7/junie-release-3659.7-linux-amd64.zip",
    "sha256": "120b58485c8f32e8018166649a000949f980b5ced29ed8cd449077e4d3c144e1",
    "cmd": "./junie-app/bin/junie",
    "args": [
      "--acp=true"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
