{
  "id": "junie",
  "name": "Junie",
  "version": "4020.10.0",
  "profileId": "junie",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/JetBrains/junie-acp-release/releases/download/4020.10/junie-release-4020.10-linux-amd64.zip",
    "sha256": "c796e66435214b376ae82d8c4a65a63dc5b34672aa29b59e84a86f0e1e1a0f13",
    "cmd": "./junie-app/bin/junie",
    "args": [
      "--acp=true"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
