{
  "id": "junie",
  "name": "Junie",
  "version": "3123.7.0",
  "enabled": false,
  "profileId": "junie",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/JetBrains/junie-acp-release/releases/download/3123.7/junie-release-3123.7-linux-amd64.zip",
    "sha256": "072bc7ec0c3cf2753859272a2271ebea5c71c17f21781e675559ed3c96022e4e",
    "cmd": "./junie-app/bin/junie",
    "args": [
      "--acp=true"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
