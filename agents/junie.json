{
  "id": "junie",
  "name": "Junie",
  "version": "3419.16.0",
  "profileId": "junie",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/JetBrains/junie-acp-release/releases/download/3419.16/junie-release-3419.16-linux-amd64.zip",
    "sha256": "f54f57d825a97d279d19afb845bbf3355bc2704d74423c8add117a97cd60c7c6",
    "cmd": "./junie-app/bin/junie",
    "args": [
      "--acp=true"
    ]
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self"
    ]
  }
}
