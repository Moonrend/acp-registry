{
  "id": "sigit",
  "name": "siGit Code",
  "version": "1.5.7",
  "profileId": "sigit",
  "dist": {
    "kind": "npx",
    "package": "@smbcloud/sigit@1.5.7"
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
