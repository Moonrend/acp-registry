{
  "id": "mistral-vibe",
  "name": "Mistral Vibe",
  "version": "2.26.1",
  "profileId": "mistral-vibe",
  "dist": {
    "kind": "binary",
    "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.26.1/vibe-acp-linux-x86_64-2.26.1.tar.gz",
    "sha256": "c8a018ca7d02eed5cebf291f6bcce1744e44323ff774b1c3fceac13794a95634",
    "cmd": "./vibe-acp"
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
