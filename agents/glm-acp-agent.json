{
  "id": "glm-acp-agent",
  "name": "GLM Agent",
  "version": "1.8.0",
  "profileId": "glm-acp-agent",
  "dist": {
    "kind": "npx",
    "package": "glm-acp-agent@1.8.0"
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}"
    },
    "artifacts": [
      {
        "durable": ".credentials.json",
        "runtime": ".credentials.json",
        "sync": "exit",
        "when": [
          "self"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "api_key"
    ]
  }
}
