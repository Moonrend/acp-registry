{
  "id": "codex-acp",
  "name": "Codex",
  "version": "1.10.0",
  "profileId": "codex",
  "dist": {
    "kind": "npx",
    "package": "@agentclientprotocol/codex-acp@1.10.0"
  },
  "storage": {
    "mode": "files",
    "env": {
      "HOME": "${RUNTIME_DIR}",
      "CODEX_HOME": "${STATE_DIR}",
      "CODEX_SQLITE_HOME": "${STATE_DIR}"
    },
    "artifacts": [
      {
        "durable": ".codex/auth.json",
        "runtime": "auth.json",
        "sync": "codex_auth",
        "when": [
          "self",
          "oauth"
        ]
      },
      {
        "durable": ".codex/auth.json",
        "runtime": "auth.json",
        "sync": "none",
        "when": [
          "api_key"
        ]
      },
      {
        "durable": ".codex/config.toml",
        "runtime": "config.toml",
        "sync": "exit",
        "when": [
          "self"
        ]
      },
      {
        "durable": ".codex/config.toml",
        "runtime": "config.toml",
        "sync": "none",
        "when": [
          "oauth",
          "api_key"
        ]
      }
    ]
  },
  "auth": {
    "modes": [
      "self",
      "oauth",
      "api_key"
    ],
    "apiKeyEnv": [
      "OPENAI_API_KEY"
    ],
    "noBrowserEnv": {
      "NO_BROWSER": "1"
    }
  }
}
